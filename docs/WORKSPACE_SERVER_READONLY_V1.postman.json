    {"name": "projects", "request": {"method": "GET", "url": "{{baseUrl}}/v1/projects", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "X-Workspace-Instance", "value": "{{instanceId}}"}]}},
    {"name": "openapi", "request": {"method": "GET", "url": "{{baseUrl}}/v1/openapi.json", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "X-Workspace-Instance", "value": "{{instanceId}}"}]}}
  ]
